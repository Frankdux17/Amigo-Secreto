<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="contenedor estrecho">
  <div class="tarjeta">
    <div class="centro" style="margin-bottom:22px">
      <div style="font-size:3.4rem">🎅</div>
      <h1 style="margin:6px 0 4px">Bienvenido de vuelta</h1>
      <p class="silencio">Ingresa para ver tu amigo secreto y pedir ideas al duende.</p>
    </div>

    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid-form">
        <div class="campo ancho">
          <label for="usuario">Usuario <span class="req">*</span></label>
          <input id="usuario" name="usuario" required autofocus placeholder="tu usuario">
        </div>
        <div class="campo ancho">
          <label for="password">Contraseña <span class="req">*</span></label>
          <input id="password" name="password" type="password" required placeholder="••••••••">
        </div>
      </div>
      <button class="btn" style="width:100%;margin-top:20px" type="submit">Ingresar 🎁</button>
    </form>

    <p class="centro silencio" style="margin-top:20px">
      ¿Aún no tienes cuenta? <a href="/registro">Crea tu usuario aquí</a>
      <% if (!cupo.completo) { %> · quedan <strong><%= cupo.faltan %></strong> lugares<% } %>
    </p>
  </div>
</main>

<%- include('partials/foot') %>
